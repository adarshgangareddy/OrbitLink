# OrbitLink Environment Configuration Template
PROJECT_NAME="OrbitLink"
ENVIRONMENT="development"
VERSION="0.1.0"
API_V1_STR="/api/v1"

# Primary PostgreSQL Database (Production & Ubuntu Linux setup)
DATABASE_URL="postgresql+psycopg://orbitlink_user:orbitlink_pass@localhost:5432/orbitlink"

# Local Fallback SQLite (Activated when PostgreSQL service is unavailable locally)
FALLBACK_SQLITE_URL="sqlite:///./orbitlink.db"
ALLOW_SQLITE_FALLBACK=True

# Network probe settings
DEFAULT_PING_TARGET="1.1.1.1"
HTTP_PROBE_URL="https://1.1.1.1/cdn-cgi/trace"
MEASUREMENT_COOLDOWN_SECONDS=3
